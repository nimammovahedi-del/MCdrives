     FitWithHeadroom,
     /// Reuse a stored mapping. Later One World areas.
     Fixed(ElevationAffine),
+    // Local change, not upstream Arnis: added by a build-time patch (arnis-fixed-base.patch).
+    /// Fit this grid's relief, but at `blocks_per_meter` and with the base on a
+    /// whole block above `base_m`, so separate bakes of neighbouring bboxes give a
+    /// ground point the same Y up to a whole number of blocks. Set from the
+    /// ARNIS_ELEVATION_BASE_M environment variable (`AffinePolicy::with_env_grid`).
+    Grid { base_m: f64, blocks_per_meter: f64 },
+}
+
+impl AffinePolicy {
+    /// `Fit` becomes `Grid` when ARNIS_ELEVATION_BASE_M (metres) is set; the vertical
+    /// blocks per metre come from ARNIS_ELEVATION_SCALE times `height_multiplier`, or
+    /// `vertical` (the run's own) without it. Every other policy is kept.
+    pub fn with_env_grid(self, vertical: f64, height_multiplier: f64) -> Self {
+        let var = |k: &str| {
+            std::env::var(k)
+                .ok()
+                .and_then(|v| v.trim().parse::<f64>().ok())
+        };
+        match (self, var("ARNIS_ELEVATION_BASE_M")) {
+            (AffinePolicy::Fit, Some(base_m)) if base_m.is_finite() => {
+                let bpm = var("ARNIS_ELEVATION_SCALE").map_or(vertical, |s| s * height_multiplier);
+                if bpm.is_finite() && bpm > 0.0 {
+                    AffinePolicy::Grid {
+                        base_m,
+                        blocks_per_meter: bpm,
+                    }
+                } else {
+                    self
+                }
+            }
+            _ => self,
+        }
+    }
 }
 
