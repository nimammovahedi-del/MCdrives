+    #[test]
+    fn grid_bases_differ_by_whole_blocks_between_bboxes() {
+        let grid = AffinePolicy::Grid {
+            base_m: 0.0,
+            blocks_per_meter: 1.003,
+        };
+        // Two overlapping "bakes" of one slope with different lowest cells.
+        let a: Vec<Vec<f64>> = vec![(0..40).map(|i| 50.37 + i as f64 * 0.61).collect()];
+        let b: Vec<Vec<f64>> = vec![a[0][17..].iter().copied().chain([90.0, 91.2]).collect()];
+        let (ya, fa) = scale_to_minecraft_with(&a, 1.0, -62, -62, false, 0, grid);
+        let (yb, fb) = scale_to_minecraft_with(&b, 1.0, -62, -62, false, 0, grid);
+        assert_eq!(fa.ground_level, -62);
+        assert!(ya[0].iter().chain(&yb[0]).all(|&y| y >= -62.0));
+        assert!((ya[0][0] - -62.0) < 1.0 && (yb[0][0] - -62.0) < 1.0);
+        let d = yb[0][0] - ya[0][17];
+        assert!((d - d.round()).abs() < 1e-9 && d.round() != 0.0);
+        for (p, q) in ya[0][17..].iter().zip(&yb[0]) {
+            assert_eq!(q.round() - p.round(), d.round());
+        }
+        // Too tall for the build height at that scale: the ordinary fit.
+        let tall = vec![vec![0.0, 1000.0]];
+        let (_, ft) = scale_to_minecraft_with(&tall, 1.0, -62, -62, false, 0, grid);
+        assert!(ft.blocks_per_meter < 0.5);
+    }
